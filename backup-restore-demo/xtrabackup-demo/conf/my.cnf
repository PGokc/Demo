[mysqld]
# 开启 binlog（增量备份需要）
log_bin                 = mysql-bin
binlog_format           = ROW
server_id               = 1
gtid_mode               = ON
enforce_gtid_consistency = ON

# 性能参数
innodb_buffer_pool_size = 256M
innodb_log_file_size    = 64M
max_connections         = 200

[client]
default-character-set   = utf8mb4
